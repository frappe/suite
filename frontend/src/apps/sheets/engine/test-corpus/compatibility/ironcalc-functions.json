      "notes": "GCD is implemented locally but LCM is not, so the pair is half present.",
      "status": "known-failure",
      "defect": "unsupported-feature",
      "actual": "#NAME?"
    },
    {
      "id": "diff-missing-roman-001",
      "formula": "=ROMAN(4)",
