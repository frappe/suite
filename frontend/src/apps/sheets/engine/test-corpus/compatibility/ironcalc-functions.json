      "category": "unsupported-function",
      "source": "ironcalc",
      "status": "known-failure",
      "defect": "unsupported-feature",
      "actual": "#NAME?"
    },
    {
      "id": "diff-missing-type-001",
      "formula": "=TYPE(1)",
      "expected": 1,
      "category": "unsupported-function",
      "source": "ironcalc",
      "status": "known-failure",
      "defect": "unsupported-feature",
      "actual": "#NAME?"
    },
    {
      "id": "diff-missing-rank-001",
      "formula": "=RANK(2,A1:A3)",
      "cells": { "A1": 1, "A2": 2, "A3": 3 },
