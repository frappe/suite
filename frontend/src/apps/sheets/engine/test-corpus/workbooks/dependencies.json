{
  "owner": "workbook",
  "cases": [
    {
      "id": "dependency-direct-001",
      "sheets": { "Sheet1": { "A1": 1, "B1": "=A1+1" } },
      "actions": [{ "type": "set", "sheet": "Sheet1", "cell": "A1", "value": 10 }],
      "expected": { "Sheet1!B1": 11 },
      "category": "dependency",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "dependency-diamond-001",
      "sheets": {
        "Sheet1": { "A1": 1, "B1": "=A1+1", "C1": "=A1+2", "D1": "=B1+C1" }
      },
      "actions": [{ "type": "set", "sheet": "Sheet1", "cell": "A1", "value": 10 }],
      "expected": { "Sheet1!B1": 11, "Sheet1!C1": 12, "Sheet1!D1": 23 },
      "category": "dependency",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "dependency-chain-001",
      "sheets": {
        "Sheet1": { "A1": 1, "A2": "=A1+1", "A3": "=A2+1", "A4": "=A3+1", "A5": "=A4+1" }
      },
      "actions": [{ "type": "set", "sheet": "Sheet1", "cell": "A1", "value": 100 }],
      "expected": { "Sheet1!A5": 104 },
      "category": "dependency",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "dependency-range-source-001",
      "sheets": { "Sheet1": { "A1": 1, "A2": 2, "A3": 3, "B1": "=SUM(A1:A3)" } },
      "actions": [{ "type": "set", "sheet": "Sheet1", "cell": "A2", "value": 20 }],
      "expected": { "Sheet1!B1": 24 },
      "category": "dependency",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "dependency-cross-sheet-001",
      "sheets": { "Sheet1": { "A1": "=Sheet2!A1+1" }, "Sheet2": { "A1": 5 } },
      "actions": [{ "type": "set", "sheet": "Sheet2", "cell": "A1", "value": 50 }],
      "expected": { "Sheet1!A1": 51 },
      "category": "dependency",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "dependency-clear-source-001",
      "sheets": { "Sheet1": { "A1": 5, "B1": "=A1*2" } },
      "actions": [{ "type": "clear", "sheet": "Sheet1", "cell": "A1" }],
      "expected": { "Sheet1!B1": 0 },
      "category": "dependency",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "dependency-formula-replaced-by-literal-001",
      "sheets": { "Sheet1": { "A1": 5, "B1": "=A1*2", "C1": "=B1+1" } },
      "actions": [
        { "type": "set", "sheet": "Sheet1", "cell": "B1", "value": 3 },
        { "type": "set", "sheet": "Sheet1", "cell": "A1", "value": 99 }
      ],
      "expected": { "Sheet1!B1": 3, "Sheet1!C1": 4 },
      "category": "cache",
      "source": "excel-compatible-semantics",
      "notes": "Replacing B1's formula must drop the old A1 to B1 edge, so a later A1 edit leaves B1 alone."
    },
    {
      "id": "circular-self-reference-001",
      "sheets": { "Sheet1": { "A1": "=A1+1" } },
      "expected": { "Sheet1!A1": "#CIRCULAR!" },
      "category": "circular-reference",
      "source": "engine-contract"
    },
    {
      "id": "circular-two-cell-cycle-001",
      "sheets": { "Sheet1": { "A1": "=B1+1", "B1": "=A1+1" } },
      "expected": { "Sheet1!A1": "#CIRCULAR!" },
      "category": "circular-reference",
      "source": "engine-contract"
    },

    {
      "id": "wb-dep-direct-roundtrip-001",
      "sheets": { "Sheet1": { "A1": 1, "B1": "=A1+1" } },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A1", "value": 10 },
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "B1", "value": 99 },
        { "type": "set", "cell": "B1", "value": "=A1+1" },
        { "type": "clear", "cell": "A1" },
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A1", "value": 1 }
      ],
      "expected": { "Sheet1!A1": 1, "Sheet1!B1": 2 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Full mutation cycle on the simplest shape. Reads are interleaved so a stale memo entry would have to survive being observed."
    },
    {
      "id": "wb-dep-direct-clear-then-restore-001",
      "sheets": { "Sheet1": { "A1": 5, "B1": "=A1*2" } },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "clear", "cell": "A1" },
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A1", "value": 5 }
      ],
      "expected": { "Sheet1!B1": 10 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Clearing a source must not orphan the edge; writing the source again has to bring the dependent back."
    },

    {
      "id": "wb-dep-chain-ten-deep-001",
      "sheets": {
        "Sheet1": {
          "A1": 1,
          "A2": "=A1+1", "A3": "=A2+1", "A4": "=A3+1", "A5": "=A4+1",
          "A6": "=A5+1", "A7": "=A6+1", "A8": "=A7+1", "A9": "=A8+1", "A10": "=A9+1"
        }
      },
      "actions": [
        { "type": "read", "cell": "A10" },
        { "type": "set", "cell": "A1", "value": 5 }
      ],
      "expected": { "Sheet1!A5": 9, "Sheet1!A10": 14 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "One edit has to cascade nine hops. A10 is read before the edit so a cached value exists to invalidate."
    },
    {
      "id": "wb-dep-chain-mid-link-replaced-001",
      "sheets": {
        "Sheet1": { "A1": 1, "A2": "=A1+1", "A3": "=A2+1", "A4": "=A3+1", "A5": "=A4+1" }
      },
      "actions": [
        { "type": "read", "cell": "A5" },
        { "type": "set", "cell": "A3", "value": 100 },
        { "type": "read", "cell": "A5" },
        { "type": "set", "cell": "A1", "value": 50 }
      ],
      "expected": { "Sheet1!A3": 100, "Sheet1!A4": 101, "Sheet1!A5": 102 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Pinning A3 to a literal cuts the chain; the later A1 edit must not reach A4 or A5."
    },
    {
      "id": "wb-dep-chain-mid-link-restored-001",
      "sheets": {
        "Sheet1": { "A1": 1, "A2": "=A1+1", "A3": "=A2+1", "A4": "=A3+1", "A5": "=A4+1" }
      },
      "actions": [
        { "type": "read", "cell": "A5" },
        { "type": "set", "cell": "A3", "value": 100 },
        { "type": "read", "cell": "A5" },
        { "type": "set", "cell": "A3", "value": "=A2+1" },
        { "type": "set", "cell": "A1", "value": 50 }
      ],
      "expected": { "Sheet1!A3": 52, "Sheet1!A4": 53, "Sheet1!A5": 54 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Restoring the formula has to re-create the A2 to A3 edge that the literal removed."
    },

    {
      "id": "wb-dep-diamond-roundtrip-001",
      "sheets": {
        "Sheet1": { "A1": 1, "B1": "=A1+1", "C1": "=A1+2", "D1": "=B1+C1" }
      },
      "actions": [
        { "type": "read", "cell": "D1" },
        { "type": "set", "cell": "A1", "value": 10 },
        { "type": "read", "cell": "D1" },
        { "type": "set", "cell": "B1", "value": 0 },
        { "type": "read", "cell": "D1" },
        { "type": "set", "cell": "B1", "value": "=A1+1" },
        { "type": "clear", "cell": "A1" },
        { "type": "read", "cell": "D1" },
        { "type": "set", "cell": "A1", "value": 1 }
      ],
      "expected": { "Sheet1!B1": 2, "Sheet1!C1": 3, "Sheet1!D1": 5 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Diamond: D1 reaches A1 by two paths, so a single invalidation must not be swallowed by the other arm."
    },
    {
      "id": "wb-dep-diamond-one-arm-pinned-001",
      "sheets": {
        "Sheet1": { "A1": 1, "B1": "=A1+1", "C1": "=A1+2", "D1": "=B1+C1" }
      },
      "actions": [
        { "type": "read", "cell": "D1" },
        { "type": "set", "cell": "B1", "value": 7 },
        { "type": "set", "cell": "A1", "value": 10 }
      ],
      "expected": { "Sheet1!B1": 7, "Sheet1!C1": 12, "Sheet1!D1": 19 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Only the surviving arm may respond to the A1 edit."
    },

    {
      "id": "wb-dep-fanout-wide-001",
      "sheets": {
        "Sheet1": {
          "A1": 2,
          "B1": "=A1*1", "B2": "=A1*2", "B3": "=A1*3", "B4": "=A1*4",
          "B5": "=A1*5", "B6": "=A1*6", "B7": "=A1*7", "B8": "=A1*8",
          "C1": "=SUM(B1:B8)"
        }
      },
      "actions": [
        { "type": "read", "cell": "C1" },
        { "type": "set", "cell": "A1", "value": 3 }
      ],
      "expected": { "Sheet1!B1": 3, "Sheet1!B8": 24, "Sheet1!C1": 108 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Eight direct dependents plus one aggregate; every one has to be invalidated by the single A1 write."
    },
    {
      "id": "wb-dep-fanin-wide-001",
      "sheets": {
        "Sheet1": {
          "A1": 1, "A2": 2, "A3": 3, "A4": 4, "A5": 5, "A6": 6, "A7": 7, "A8": 8,
          "B1": "=A1+A2+A3+A4+A5+A6+A7+A8"
        }
      },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A5", "value": 50 },
        { "type": "read", "cell": "B1" },
        { "type": "clear", "cell": "A1" }
      ],
      "expected": { "Sheet1!B1": 80 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Eight sources into one formula; an edit to any single one has to invalidate it."
    },

    {
      "id": "wb-dep-range-roundtrip-001",
      "sheets": { "Sheet1": { "A1": 1, "A2": 2, "A3": 3, "B1": "=SUM(A1:A3)" } },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A2", "value": 20 },
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "B1", "value": 0 },
        { "type": "set", "cell": "B1", "value": "=SUM(A1:A3)" },
        { "type": "clear", "cell": "A3" },
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A3", "value": 3 },
        { "type": "set", "cell": "A2", "value": 2 }
      ],
      "expected": { "Sheet1!B1": 6 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Every cell inside a range literal is an edge of its own."
    },
    {
      "id": "wb-dep-range-edge-cell-001",
      "sheets": { "Sheet1": { "A1": 1, "A2": 2, "A3": 3, "A4": 99, "B1": "=SUM(A1:A3)" } },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A4", "value": 1000 }
      ],
      "expected": { "Sheet1!B1": 6 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "A4 sits one row past the range, so it must not be an edge."
    },
    {
      "id": "wb-dep-range-fill-empty-cell-001",
      "sheets": { "Sheet1": { "A1": 1, "A3": 3, "B1": "=SUM(A1:A3)" } },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A2", "value": 10 }
      ],
      "expected": { "Sheet1!B1": 14 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Writing a cell that was empty when the range was registered must still invalidate the aggregate."
    },

    {
      "id": "wb-dep-cross-sheet-range-001",
      "sheets": {
        "Sheet1": { "B1": "=SUM(Data!A1:A3)" },
        "Data": { "A1": 1, "A2": 2, "A3": 3 }
      },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "sheet": "Data", "cell": "A2", "value": 20 },
        { "type": "read", "cell": "B1" },
        { "type": "clear", "sheet": "Data", "cell": "A3" },
        { "type": "set", "sheet": "Data", "cell": "A3", "value": 3 },
        { "type": "set", "sheet": "Data", "cell": "A2", "value": 2 }
      ],
      "expected": { "Sheet1!B1": 6 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "Remote range edges must survive a clear-and-restore cycle on the far sheet."
    },
    {
      "id": "wb-dep-cross-sheet-single-roundtrip-001",
      "sheets": {
        "Sheet1": { "B1": "=Data!A1*2" },
        "Data": { "A1": 5 }
      },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "sheet": "Data", "cell": "A1", "value": 50 },
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "B1", "value": 0 },
        { "type": "set", "cell": "B1", "value": "=Data!A1*2" },
        { "type": "clear", "sheet": "Data", "cell": "A1" },
        { "type": "read", "cell": "B1" },
        { "type": "set", "sheet": "Data", "cell": "A1", "value": 5 }
      ],
      "expected": { "Sheet1!B1": 10 },
      "category": "dependency",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "wb-dep-cross-sheet-two-hop-001",
      "sheets": {
        "Sheet1": { "A1": "=Data!A1+1" },
        "Data": { "A1": "=Extra!A1+1" },
        "Extra": { "A1": 1 }
      },
      "actions": [
        { "type": "read", "cell": "A1" },
        { "type": "set", "sheet": "Extra", "cell": "A1", "value": 100 }
      ],
      "expected": { "Sheet1!A1": 102, "Data!A1": 101 },
      "category": "dependency",
      "source": "excel-compatible-semantics",
      "notes": "The cascade has to cross two sheet boundaries, not just one."
    },

    {
      "id": "wb-circular-three-cell-cycle-001",
      "sheets": { "Sheet1": { "A1": "=B1+1", "B1": "=C1+1", "C1": "=A1+1" } },
      "expected": { "Sheet1!A1": "#CIRCULAR!", "Sheet1!B1": "#CIRCULAR!", "Sheet1!C1": "#CIRCULAR!" },
      "category": "circular-reference",
      "source": "engine-contract",
      "notes": "Excel and Sheets both refuse a three-cell cycle; this engine's sentinel is #CIRCULAR!."
    },
    {
      "id": "wb-circular-cross-sheet-cycle-001",
      "sheets": {
        "Sheet1": { "A1": "=Sheet2!A1+1" },
        "Sheet2": { "A1": "=Sheet1!A1+1" }
      },
      "expected": { "Sheet1!A1": "#CIRCULAR!", "Sheet2!A1": "#CIRCULAR!" },
      "category": "circular-reference",
      "source": "engine-contract",
      "notes": "The recursion guard is keyed by sheet and cell, so a cycle that leaves and re-enters a sheet is still caught."
    },
    {
      "id": "wb-circular-repaired-001",
      "sheets": { "Sheet1": { "A1": "=B1+1", "B1": "=A1+1", "C1": "=A1*10" } },
      "actions": [
        { "type": "read", "cell": "C1" },
        { "type": "set", "cell": "B1", "value": 10 }
      ],
      "expected": { "Sheet1!A1": 11, "Sheet1!C1": 110 },
      "category": "circular-reference",
      "source": "excel-compatible-semantics",
      "notes": "Breaking a cycle must clear the sentinel from the cycle members and from anything downstream of them."
    },
    {
      "id": "wb-circular-introduced-later-001",
      "sheets": { "Sheet1": { "A1": 1, "B1": "=A1+1" } },
      "actions": [
        { "type": "read", "cell": "B1" },
        { "type": "set", "cell": "A1", "value": "=B1+1" }
      ],
      "expected": { "Sheet1!A1": "#CIRCULAR!", "Sheet1!B1": "#CIRCULAR!" },
      "category": "circular-reference",
      "source": "engine-contract",
      "notes": "A cycle created by a later edit has to invalidate the already-cached dependent."
    },
    {
      "id": "wb-circular-range-contains-self-001",
      "sheets": { "Sheet1": { "A1": 1, "A2": 2, "A3": "=SUM(A1:A3)" } },
      "expected": { "Sheet1!A3": "#CIRCULAR!" },
      "category": "circular-reference",
      "source": "excel-compatible-semantics",
      "notes": "Excel and Sheets both flag =SUM(A1:A3) written into A3 as a circular reference. This engine lets SUM skip the recursive sentinel and returns the sum of the other two cells, so the sheet silently under-reports its own total.",
      "status": "known-failure",
      "defect": "circular-reference",
      "actual": { "Sheet1!A3": 3 }
    },
    {
      "id": "wb-circular-self-reference-plain-001",
      "sheets": { "Sheet1": { "A1": "=A1" } },
      "expected": { "Sheet1!A1": "#CIRCULAR!" },
      "category": "circular-reference",
      "source": "engine-contract",
      "notes": "Direct self-reference with no arithmetic around it."
    }
  ]
}
