    {
      "id": "syntax-ref-a1-001",
      "formula": "=A1",
      "cells": { "A1": 7 },
      "expected": 7,
      "category": "reference",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "syntax-ref-lowercase-001",
      "formula": "=a1",
      "cells": { "A1": 7 },
      "expected": 7,
      "category": "reference",
      "source": "excel-compatible-semantics"
    },
    {
      "id": "syntax-ref-absolute-001",
      "formula": "=$A$1",
      "cells": { "A1": 7 },
      "expected": 7,
      "category": "reference",
      "source": "excel-compatible-semantics",
      "notes": "The tokenizer drops a leading `$` (no branch matches it) and folds the rest into an identifier, so every absolute reference resolves to #NAME?. Absolute references are the documented way to pin a reference during fill and paste.",
      "status": "known-failure",
      "defect": "reference-resolution",
      "actual": "#NAME?"
    },
    {
      "id": "syntax-ref-absolute-col-001",
      "formula": "=$A1",
      "cells": { "A1": 7 },
      "expected": 7,
      "category": "reference",
      "source": "excel-compatible-semantics",
      "notes": "This one form survives by accident: `$` is silently dropped, and what remains (`A1`) still tokenises as a reference. `A$1` and `$A$1` do not."
    },
    {
      "id": "syntax-ref-absolute-row-001",
      "formula": "=A$1",
      "cells": { "A1": 7 },
      "expected": 7,
      "category": "reference",
      "source": "excel-compatible-semantics",
      "status": "known-failure",
      "defect": "reference-resolution",
      "actual": "#NAME?"
    },
    {
