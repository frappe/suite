   "fieldname": "default_gravatar",
   "fieldtype": "Select",
   "label": "Default Gravatar",
   "options": "404\nmp\nidenticon\nmonsterid\nwavatar\nretro\nrobohash\nblank",
   "reqd": 1
  },
