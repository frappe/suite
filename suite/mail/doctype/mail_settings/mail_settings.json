 "fields": [
  {
   "fieldname": "config_tab",
   "fieldtype": "Tab Break",
   "label": "Mail Server"
  },
  {
   "fieldname": "jmap_section",
   "fieldtype": "Section Break",
   "label": "Mail Server"
  },
  {
   "fieldname": "server_url",
   "fieldtype": "Data",
   "label": "JMAP URL",
   "options": "URL",
   "placeholder": "https://mail.frappemail.com",
   "description": "Address of the mail cluster users connect to, e.g. https://mail.blr.frappemail.com. Frappe Cloud writes it into the site config; set it here to override."
  },
  {
   "default": "1",
   "description": "Verify the server's SSL certificate. Disable only for local development against a server with a self-signed certificate.",
   "fieldname": "verify_ssl",
   "fieldtype": "Check",
   "label": "Verify SSL"
  },
  {
   "fieldname": "column_break_xvlo",
   "fieldtype": "Column Break"
  },
  {
   "description": "Suite Cloud that manages this site's domains, accounts, groups and lists, e.g. https://cloud.frappemail.com. Frappe Cloud writes it into the site config; set it here to override.",
   "fieldname": "suite_cloud_url",
   "fieldtype": "Data",
   "label": "Suite Cloud URL",
   "options": "URL"
  },
  {
   "description": "This site's key at Suite Cloud, issued when Frappe Cloud registered the site.",
   "fieldname": "site_api_key",
   "fieldtype": "Data",
   "label": "Site API Key",
   "mandatory_depends_on": "eval: doc.site_api_secret"
  },
  {
   "description": "This site's secret at Suite Cloud, shown once by Frappe Cloud. Rotate it from Frappe Cloud if it leaks.",
   "fieldname": "site_api_secret",
   "fieldtype": "Password",
   "label": "Site API Secret",
   "mandatory_depends_on": "eval: doc.site_api_key"
  },
  {
   "collapsible": 1,
   "collapsible_depends_on": "eval: true",
   "fieldname": "mail_client_config_section",
   "fieldtype": "Section Break",
   "label": "Mail Client Configuration"
  },
  {
   "default": "1",
   "description": "Show the SMTP/IMAP/POP connection details in the Mail UI so users can set up third-party mail clients. When unchecked, nothing is shown.",
   "fieldname": "show_mail_client_config",
   "fieldtype": "Check",
   "label": "Show Connection Details in Mail UI"
  },
  {
   "default": "1",
   "description": "Show the CalDAV connection details in the Calendar UI so users can set up third-party calendar clients. When unchecked, nothing is shown.",
   "fieldname": "show_calendar_client_config",
   "fieldtype": "Check",
   "label": "Show Connection Details in Calendar UI"
  },
  {
   "depends_on": "eval: doc.show_mail_client_config",
   "description": "Connection endpoints shown to users. Leave empty to fall back to the domain's DNS records.",
   "fieldname": "mail_client_configurations",
   "fieldtype": "Table",
   "label": "Mail Client Configuration",
   "options": "Mail Client Configuration"
  },
  {
   "collapsible": 1,
   "collapsible_depends_on": "eval: true",
   "fieldname": "spamassassin_section",
   "fieldtype": "Section Break",
   "label": "SpamAssassin"
  },
  {
   "fieldname": "spamd_host",
   "fieldtype": "Data",
   "label": "Host",
   "placeholder": "spamd.example.com"
  },
