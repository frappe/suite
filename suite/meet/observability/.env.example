GRAFANA_DOMAIN=metrics.example.com
GRAFANA_ROOT_URL=https://metrics.example.com
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
PROMETHEUS_RETENTION=30d
LOKI_PUSH_DOMAIN=logs.example.com
LOKI_PUSH_USER=alloy
# Keep bcrypt hashes single-quoted so Docker Compose does not expand dollar signs.
LOKI_PUSH_PASSWORD_HASH='replace-with-a-caddy-bcrypt-hash'
