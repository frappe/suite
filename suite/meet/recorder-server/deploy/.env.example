# Public HTTPS endpoint for Frappe-to-recorder control requests.
RECORDER_DOMAIN=recorder.example.com
TLS_EMAIL=admin@example.com

RECORDER_IMAGE=ghcr.io/frappe/suite/meet-recorder-server:latest
RECORDER_SECRET=change-me-to-an-independent-strong-random-string
RECORDER_METRICS_TOKEN=change-me-to-an-independent-metrics-token

# Exact Frappe site name and HTTPS origin authorized to control this endpoint.
RECORDER_SITE=site.example.com
RECORDER_SITE_ORIGIN=https://site.example.com

# Existing public Meet SFU origin observed by the Recorder Endpoint.
SFU_ORIGIN=https://sfu.example.com
SFU_SOCKET_PATH=/socket.io

RECORDER_MAX_CONCURRENT=1
RECORDER_CPUS=4
RECORDER_MEMORY=6g
RECORDER_PIDS_LIMIT=512
