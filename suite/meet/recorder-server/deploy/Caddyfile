{
	email {$TLS_EMAIL}
}

{$RECORDER_DOMAIN} {
	route {
		@metrics path /recorder/metrics
		handle @metrics {
			rewrite * /metrics
			reverse_proxy 127.0.0.1:3010
		}

		@control path /v1/recordings /v1/recordings/*
		reverse_proxy @control 127.0.0.1:3010

		@status path /health /ready
		reverse_proxy @status 127.0.0.1:3010

		respond 404
	}
}
