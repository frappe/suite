{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!dist",
			"!integration/output",
			"!node_modules",
			"!yarn.lock"
		]
	},
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"linter": { "enabled": true },
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	}
}
