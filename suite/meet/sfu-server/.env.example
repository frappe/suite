# SFU Server Environment Configuration
# Copy this file to .env and update the values

# JWT Secret for authentication (MUST match Frappe site config sfu_secret)
JWT_SECRET=your_jwt_secret_here

# Server settings
NODE_ENV=development
PORT=3000
HOST=localhost
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Worker settings
MEDIASOUP_NUM_WORKERS=2
MEDIASOUP_WORKER_LOGLEVEL=warn

# WebRTC settings
WEBRTC_LISTEN_IP=127.0.0.1
WEBRTC_ANNOUNCED_IP=127.0.0.1
WEBRTC_SERVER_PORT=40000

# Optional persistence paths
RECORDING_GRANT_PERSISTENCE_FILE=
E2EE_ROSTER_PERSISTENCE_DIR=

# TURN server settings (optional)
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password

# STT / Captions
STT_SERVER_URL=http://localhost:8000
# Bearer token sent to the STT server when it requires authentication
# STT_API_KEY=your-stt-api-key
# NEMOTRON_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
# NEMOTRON_LANGUAGE=en-US            # pin language for stability; use auto only for multilingual rooms
# NEMOTRON_ATT_CONTEXT_SIZE=56,3
# NEMOTRON_FINAL_SILENCE_MS=600
# Local diagnosis only; captures participant audio.
# STT_CAPTURE_DIR=./data/stt-captures
# STT_PRE_ROLL_MS=300
# STT_SILENCE_MS=500
# STT_MIN_SPEECH_MS=600
# STT_MIN_TAIL_MS=200
# STT_SHORT_UTTERANCE_SILENCE_MS=700
# STT_VAD_THRESHOLD=0.012

# Hugging Face token (optional, avoids rate-limit warnings when downloading models)
# HF_TOKEN=hf_...

# Legacy settings (for backward compatibility)
API_KEY=your-api-key-here
SECRET_KEY=your-secret-key-here

# Logging
SFU_LOG_LEVEL=debug

# Prometheus metrics (optional; /metrics returns 404 when unset)
METRICS_TOKEN=your_metrics_bearer_token_here

# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Production example:
# JWT_SECRET=your_strong_random_secret_here
# WEBRTC_ANNOUNCED_IP=your.public.ip.address
