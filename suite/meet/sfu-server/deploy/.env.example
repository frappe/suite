# ==============================================================================
# Frappe Meet SFU — Deployment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values before running deploy.sh
#
#   cp .env.example .env
#   nano .env
#   ./deploy.sh setup
# ==============================================================================

# === Domain & SSL =============================================================
# The public domain that points to this server (A/AAAA record).
# Example: sfu.meet.example.com
DOMAIN=sfu.example.com

# Email for Let's Encrypt certificate notifications.
SSL_EMAIL=admin@example.com

# === SFU Image ================================================================
# Docker image to pull. The GitHub Actions workflow pushes to this tag.
SFU_IMAGE=ghcr.io/frappe/suite/meet-sfu-server:latest

# === SFU Server ===============================================================
# JWT secret — MUST match the "sfu_secret" in your Frappe site_config.json.
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-string

# Optional Prometheus bearer token. Leave blank to disable /metrics.
METRICS_TOKEN=

# Internal port (bound to localhost and proxied by nginx).
PORT=3000
HOST=127.0.0.1
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# === WebRTC / Mediasoup =======================================================
# Local interface IP to bind media sockets. Leave blank to auto-detect.
# Set this to the server's private IP if auto-detection picks the wrong interface.
WEBRTC_LISTEN_IP=

# Required in production. Clients use this PUBLIC IP for WebRTC media.
WEBRTC_ANNOUNCED_IP=

# First UDP port for WebRTC media. The SFU opens one UDP port per mediasoup worker:
# WEBRTC_SERVER_PORT through WEBRTC_SERVER_PORT + MEDIASOUP_NUM_WORKERS - 1.
WEBRTC_SERVER_PORT=40000

# Number of mediasoup workers. Leave blank to auto-detect from CPU cores.
MEDIASOUP_NUM_WORKERS=

# Worker log verbosity: debug | warn | error | none
MEDIASOUP_WORKER_LOGLEVEL=warn

# === STT / Captions ==========================================================
# URL of an external STT backend that supports /health and /v1/realtime.
STT_SERVER_URL=http://127.0.0.1:8000

# Bearer token sent to the STT server when it requires authentication.
# STT_API_KEY=

# Nemotron ASR settings for the standalone stt-server/server.py process.
NEMOTRON_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
NEMOTRON_LANGUAGE=en-US
NEMOTRON_ATT_CONTEXT_SIZE=56,3
NEMOTRON_FINAL_SILENCE_MS=600
STT_SILENCE_MS=500
STT_MIN_SPEECH_MS=600
STT_MIN_TAIL_MS=200
STT_SHORT_UTTERANCE_SILENCE_MS=700

# Speech detection sensitivity (0.0–1.0). Lower = more sensitive.
STT_VAD_THRESHOLD=0.012

# Hugging Face token (optional). Setting this avoids rate-limit warnings
# when downloading models. Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...

# === Logging ==================================================================
SFU_LOG_LEVEL=info

# Optional centralized logs. Create secrets/loki-password, then start the Alloy
# profile as documented in suite/meet/observability/README.md.
ALLOY_ENVIRONMENT=production
ALLOY_HOST=
LOKI_PUSH_URL=https://metrics.example.com/loki/api/v1/push
LOKI_PUSH_USER=alloy

# === Error Tracking ===========================================================
# Optional Sentry project for unexpected SFU errors. Use a separate project from
# the browser/backend if you want independent ownership and alerting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
