TRANSCRIPTION_DOMAIN=transcription.example.com
TLS_EMAIL=operations@example.com
TRANSCRIPTION_CACHE_MOUNT=/mnt/asr-cache
TRANSCRIPTION_GPU_DEVICE=0
TRANSCRIPTION_CACHE_DIR=/mnt/asr-cache/transcription-models
# Shared-host starting values; see README before starting beside live captions.
TRANSCRIPTION_CPUS=1
TRANSCRIPTION_CPU_SHARES=128
TRANSCRIPTION_OOM_SCORE_ADJ=500
TRANSCRIPTION_MEMORY=5g
TRANSCRIPTION_ALLOCATOR_GIB=6
