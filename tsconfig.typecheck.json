{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable", "webworker"],
    "paths": {
      "@/*": ["./frontend/src/*"]
    },
    "types": ["unplugin-icons/types/vue", "vite/client"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "frontend/src/env.d.ts",
    "frontend/src/api/**/*.ts",
    "frontend/src/platform/**/*.ts",
    "frontend/src/platform/**/*.vue",
    "frontend/src/shell/**/*.ts",
    "frontend/src/shell/**/*.vue",
    "frontend/src/composition/**/*.ts",
    "frontend/src/composition/**/*.vue",
    "frontend/src/boot/**/*.ts",
    "frontend/src/boot/**/*.vue",
    "frontend/src/components/settings/**/*.ts",
    "frontend/src/components/settings/**/*.vue",
    "frontend/src/composables/**/*.ts",
    "frontend/src/composables/**/*.vue",
    "frontend/src/router/**/*.ts",
    "frontend/src/router/**/*.vue",
    "frontend/src/stores/**/*.ts",
    "frontend/src/stores/**/*.vue",
    "frontend/src/shims/**/*.ts",
    "frontend/src/shims/**/*.vue",
    "frontend/src/test/**/*.ts",
    "frontend/src/test/**/*.vue",
    "frontend/src/utils/**/*.ts",
    "frontend/src/utils/**/*.vue",
    "frontend/src/apps/*/client/**/*.ts",
    "frontend/src/apps/*/client/**/*.vue",
    "frontend/src/apps/*/surface/**/*.ts",
    "frontend/src/apps/*/surface/**/*.vue",
    "frontend/src/apps/drive/**/*.ts",
    "frontend/src/apps/drive/**/*.vue",
    "frontend/src/apps/calendar/components/CommandPalette/**/*.ts",
    "frontend/src/apps/calendar/components/CommandPalette/**/*.vue",
    "frontend/src/apps/calendar/components/Settings/**/*.ts",
    "frontend/src/apps/calendar/components/Settings/**/*.vue",
    "frontend/src/apps/calendar/types/**/*.ts",
    "frontend/src/apps/calendar/types/**/*.vue",
    "frontend/src/apps/mail/components/CommandPalette/**/*.ts",
    "frontend/src/apps/mail/components/CommandPalette/**/*.vue",
    "frontend/src/apps/mail/components/Screener/**/*.ts",
    "frontend/src/apps/mail/components/Screener/**/*.vue",
    "frontend/src/apps/mail/components/mobile/**/*.ts",
    "frontend/src/apps/mail/components/mobile/**/*.vue",
    "frontend/src/apps/mail/stores/**/*.ts",
    "frontend/src/apps/mail/stores/**/*.vue",
    "frontend/src/apps/mail/types/**/*.ts",
    "frontend/src/apps/mail/types/**/*.vue",
    "frontend/src/apps/meet/data/**/*.ts",
    "frontend/src/apps/meet/data/**/*.vue",
    "frontend/src/apps/meet/utils/diagnostics/**/*.ts",
    "frontend/src/apps/meet/utils/diagnostics/**/*.vue",
    "frontend/src/apps/meet/utils/identity/**/*.ts",
    "frontend/src/apps/meet/utils/identity/**/*.vue",
    "frontend/src/apps/meet/utils/telemetry/**/*.ts",
    "frontend/src/apps/meet/utils/telemetry/**/*.vue",
    "frontend/src/apps/people/stores/**/*.ts",
    "frontend/src/apps/people/stores/**/*.vue",
    "frontend/src/apps/writer/composables/**/*.ts",
    "frontend/src/apps/writer/composables/**/*.vue"
  ]
}
