{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "frappe-ui/**"
  ],
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    ".": {
      "entry": ["realtime/handlers.js", "suite/public/js/ff_integration.bundle.js", "suite/public/js/file.js"],
      "project": ["realtime/**/*.js", "suite/public/js/**/*.{js,ts,vue}", "suite/meet/type-policy/**/*.mjs"],
      "github-actions": false
    },
    "frontend": {
      "entry": [
        "recorder/main.ts",
        "recorder/frappeUi.ts",
        "src/apps/mail/sw.ts",
        "src/apps/sheets/engine/difftest/compare-engines.js",
        "src/apps/sheets/engine/difftest/run.js",
        "scripts/generate-pwa-splash.mjs"
      ],
      "project": ["src/**/*.{js,ts,tsx,vue}", "recorder/**/*.{js,ts,tsx,vue}", "scripts/**/*.{js,mjs,cjs,ts}", "*.{js,mjs,cjs,ts}"],
      "ignoreDependencies": ["@workadventure/noise-suppression", "@noble/hashes", "hyperformula"],
      "ignoreUnresolved": ["~icons/lucide/*", "unplugin-icons/types/vue"]
    },
    "e2e": {
      "entry": [
        "drive-backed-apps/global-setup.ts",
        "drive-backed-apps/global-teardown.ts",
        "meet/global-setup.ts"
      ],
      "project": [
        "shared/**/*.ts",
        "drive-backed-apps/**/*.ts",
        "meet/**/*.ts"
      ],
      "playwright": {"config": ["{drive-backed-apps,meet}/playwright.config.ts"]}
    },
    "suite/meet/sfu-server": {
      "entry": ["src/server/RecordingGrantPersistenceFile.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.js"]
    },
    "suite/meet/recorder-server": {
      "entry": ["src/integration/*.integration.ts"],
      "project": ["src/**/*.ts"]
    },
    "suite/sheets/collab-server": {
      "project": ["*.js", "test/**/*.js"]
    }
  }
}
