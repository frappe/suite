{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"],
    "paths": {
      "@/platform/transport": ["../frontend/src/platform/transport/index.ts"],
      "@/*": ["../frontend/src/*"]
    }
  },
  "include": ["**/*.ts"]
}
