{
  "name": "suite",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "yarn workspace @suite/frontend build",
    "dev": "yarn workspace @suite/frontend dev",
    "test:e2e": "yarn --cwd e2e test",
    "test:e2e:drive-backed-apps": "yarn --cwd e2e test:drive-backed-apps",
    "test:e2e:meet": "yarn --cwd e2e test:meet",
    "test:realtime": "node --test realtime/*.test.js",
    "knip:e2e": "knip --workspace e2e",
    "knip:frontend": "knip --workspace frontend",
    "knip:sfu-server": "knip --workspace suite/meet/sfu-server",
    "knip:sheets-collab": "knip --workspace suite/sheets/collab-server",
    "knip": "knip",
    "check:meet-types": "node suite/meet/type-policy/check.mjs",
    "test:meet-type-policy": "node --test suite/meet/type-policy/check.test.mjs"
  },
  "resolutions": {
    "@tiptap/core": "3.26.0",
    "@tiptap/pm": "3.26.0",
    "@tiptap/vue-3": "3.26.0"
  },
  "devDependencies": {
    "knip": "^6.4.1",
    "typescript": "^6.0.3"
  }
}
